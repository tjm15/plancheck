{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "reviewable_foundation"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "jurisdiction": {
          "const": "England"
        },
        "plan_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "supported_assessment_from": {
          "type": "string",
          "format": "date"
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "jurisdiction",
        "plan_kinds",
        "supported_assessment_from",
        "excluded"
      ],
      "additionalProperties": false
    },
    "regimes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "legacy",
              "new"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "legal_basis": {
            "enum": [
              "saved_2012",
              "pcpa_15c"
            ]
          },
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "ordinary_submission_cutoff": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "cutoff_inclusive": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "continuation": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "legal_basis",
                    "guidance",
                    "context"
                  ]
                }
              },
              "required": [
                "source",
                "locator",
                "role"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "legal_basis",
          "effective_from",
          "effective_to",
          "ordinary_submission_cutoff",
          "cutoff_inclusive",
          "continuation",
          "sources",
          "exceptions"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "document",
              "evidence",
              "output"
            ]
          },
          "integration_links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "integration_links"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "regime": {
            "enum": [
              "legacy",
              "new"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "preparation",
              "consultation",
              "assessment",
              "submission",
              "examination",
              "pause",
              "reporting",
              "adoption",
              "withdrawal",
              "gateway"
            ]
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "legal_basis",
                    "guidance",
                    "context"
                  ]
                }
              },
              "required": [
                "source",
                "locator",
                "role"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "regime",
          "label",
          "kind",
          "actors",
          "inputs",
          "outputs",
          "sources"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "boolean",
              "string",
              "date"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "enum": [
              "record",
              "professional_judgement"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "description",
          "assessment"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "regime": {
            "enum": [
              "legacy",
              "new"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "statutory",
              "guidance",
              "service_target",
              "policy_expectation"
            ]
          },
          "applicability": {
            "$ref": "#/$defs/expression"
          },
          "check": {
            "$ref": "#/$defs/expression"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "legal_basis",
                    "guidance",
                    "context"
                  ]
                }
              },
              "required": [
                "source",
                "locator",
                "role"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "temporal": {
            "type": "object",
            "properties": {
              "effective_from": {
                "type": "string",
                "format": "date"
              },
              "effective_to": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "basis": {
                "enum": [
                  "guidance_version",
                  "commencement_and_savings"
                ]
              }
            },
            "required": [
              "effective_from",
              "effective_to",
              "basis"
            ],
            "additionalProperties": false
          },
          "timing": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "minimum",
                      "maximum",
                      "target",
                      "normal_expectation",
                      "qualitative"
                    ]
                  },
                  "quantity": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unit": {
                    "anyOf": [
                      {
                        "enum": [
                          "days",
                          "weeks",
                          "calendar_months",
                          "working_days"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "anchor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endpoint": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calculation": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "quantity",
                  "unit",
                  "anchor",
                  "endpoint",
                  "calculation"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "verification": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "primary_text_checked",
                  "guidance_checked"
                ]
              },
              "checked_on": {
                "type": "string",
                "format": "date"
              },
              "review": {
                "enum": [
                  "maintainer_review_pending",
                  "maintainer_reviewed"
                ]
              }
            },
            "required": [
              "level",
              "checked_on",
              "review"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "stage",
          "regime",
          "actor",
          "statement",
          "status",
          "applicability",
          "check",
          "documents",
          "sources",
          "temporal",
          "timing",
          "exceptions",
          "verification",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from_stage": {
            "type": "string",
            "minLength": 1
          },
          "to_stage": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "sequence",
              "remedy",
              "decision",
              "discretion",
              "advisory"
            ]
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "legal_basis",
                    "guidance",
                    "context"
                  ]
                }
              },
              "required": [
                "source",
                "locator",
                "role"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "from_stage",
          "to_stage",
          "kind",
          "condition",
          "sources"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "coverage": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "description",
        "gaps"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "model_version",
    "knowledge_date",
    "status",
    "scope",
    "regimes",
    "actors",
    "documents",
    "stages",
    "facts",
    "rules",
    "transitions",
    "coverage"
  ],
  "additionalProperties": false,
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "constant"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "eq"
            },
            "fact": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "boolean",
                "string"
              ]
            }
          },
          "required": [
            "op",
            "fact",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "date_gap_at_least"
            },
            "start": {
              "type": "string",
              "minLength": 1
            },
            "end": {
              "type": "string",
              "minLength": 1
            },
            "days": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "op",
            "start",
            "end",
            "days"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
