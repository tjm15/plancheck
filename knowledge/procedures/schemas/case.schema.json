{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "plan_kind": {
          "type": "string",
          "minLength": 1
        },
        "legal_basis": {
          "enum": [
            "saved_2012",
            "pcpa_15c",
            "unknown"
          ]
        },
        "assessment_date": {
          "type": "string",
          "format": "date"
        },
        "procedure_route": {
          "enum": [
            "ordinary_lpa",
            "special_or_unknown"
          ]
        },
        "basis_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "jurisdiction",
        "plan_kind",
        "legal_basis",
        "assessment_date",
        "procedure_route",
        "basis_evidence_refs"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "boolean",
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "value",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "synthetic",
              "document",
              "decision",
              "record"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "locator",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "expected": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "satisfied",
          "not_satisfied",
          "advisory_gap",
          "target_missed",
          "unknown",
          "not_applicable"
        ]
      }
    },
    "expected_route": {
      "enum": [
        "legacy",
        "new",
        "unknown",
        "out_of_scope",
        "legacy_eligibility_unestablished"
      ]
    }
  },
  "required": [
    "id",
    "description",
    "context",
    "facts",
    "evidence",
    "rule_ids"
  ],
  "additionalProperties": false
}
